# Tenstorrent Simulator Playground - Environment Configuration
# Copy this file to .env and modify as needed

# =============================================================================
# Backend Settings
# =============================================================================

# Enable debug logging (true/false)
DEBUG=false

# API server host and port
HOST=0.0.0.0
PORT=8000

# =============================================================================
# WSL2 Settings (Windows only)
# =============================================================================

# Name of your WSL2 distribution
WSL_DISTRO=Ubuntu

# =============================================================================
# Simulator Settings (paths inside WSL2)
# =============================================================================

# Path to tt-metal installation (contains SOC descriptors)
TT_METAL_HOME=~/tt-metal

# Path to ttsim simulator library
# Options: libttsim_wh.so (Wormhole) or libttsim_bh.so (Blackhole)
TT_METAL_SIMULATOR=~/ttsim/libttsim_wh.so

# Simulation timeout in seconds
SIMULATOR_TIMEOUT=300

# =============================================================================
# CORS Settings
# =============================================================================

# Comma-separated list of allowed origins for CORS
# Add your production frontend URL here when deploying
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# Frontend Settings (for production builds)
# =============================================================================

# Backend API URL (only needed for production frontend builds)
# VITE_API_URL=http://localhost:8000
